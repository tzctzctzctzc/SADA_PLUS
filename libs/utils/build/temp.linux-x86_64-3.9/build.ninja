ninja_required_version = 1.3
cxx = c++

cflags = -pthread -B /home/dpujolpe/.conda/envs/main/compiler_compat -Wl,--sysroot=/ -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /home/dpujolpe/.conda/envs/main/include -fPIC -O2 -isystem /home/dpujolpe/.conda/envs/main/include -fPIC -I/home/dpujolpe/.conda/envs/main/lib/python3.9/site-packages/torch/include -I/home/dpujolpe/.conda/envs/main/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/home/dpujolpe/.conda/envs/main/lib/python3.9/site-packages/torch/include/TH -I/home/dpujolpe/.conda/envs/main/lib/python3.9/site-packages/torch/include/THC -I/home/dpujolpe/.conda/envs/main/include/python3.9 -c
post_cflags = -fopenmp -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=nms_1d_cpu -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc



build /SADA/libs/utils/build/temp.linux-x86_64-3.9/./csrc/nms_cpu.o: compile /SADA/libs/utils/csrc/nms_cpu.cpp





